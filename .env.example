# API port used by the local backend
PORT=3001

# Browser origin allowed to use the session-authenticated local API.
CLIENT_ORIGIN=http://127.0.0.1:5173

# Local EVM RPC. Leave unset to run the self-contained Ganache chain in memory.
# RPC_URL=http://127.0.0.1:8545

# Set to true to redeploy the contract on every server start.
RESET_CHAIN=false

# Optional hosted AI. Keep both blank to use the local permission-filtered
# assistant. When configured, only server-filtered document metadata is sent
# to the model; evidence files and unrestricted registry rows are NEVER sent.
#
# Provider priority: Gemini (preferred) → OpenAI → local fallback
#
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
